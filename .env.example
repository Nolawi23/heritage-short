# Copy to .env and fill in. Keys are only needed when a stage has to call a model
# (a clean clone rebuilds the film from the committed cache without any of them).
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
KAGGLE_USERNAME=
# New-format Kaggle token (also accepted from ~/.kaggle/access_token)
KAGGLE_API_TOKEN=
