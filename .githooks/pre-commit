#!/bin/sh
# Installed by `make setup` (git config core.hooksPath .githooks). Blocks commits that contain keys.
cd "$(git rev-parse --show-toplevel)" || exit 1
PY="${VENV:-$HOME/.venvs/heritage-short}/bin/python"; [ -x "$PY" ] || PY=.venv/bin/python; [ -x "$PY" ] || PY=python3
exec "$PY" -m pipeline.check_secrets
